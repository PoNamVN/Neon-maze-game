[node name="HelpLabel" type="Label" parent="PanelContainer/MarginContainer/VBoxContainer"]
layout_mode = 2
text = "[F1 / ~] Đóng/Mở Bảng Test
[F2] Bật/Tắt GOD MODE (Bất tử)
[F3] Soi sáng toàn map (Tắt bóng tối)
[F4] Tự động nhặt ngay 1 Core
[F5] Tự sát (Kiểm tra Full Reset)
[F6] Chuyển ngay sang Sector tiếp theo
[F7] Tua chậm thời gian (0.25x Slow-mo)
[F8] Phóng sóng Sonar Radar"
